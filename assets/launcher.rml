<rml>
	<head>
		<title>Launcher</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			/*
				Launcher, redesigned with unslop (https://github.com/heydamir/unslop, CC BY 4.0, by Damir Sokolovsky).
				Direction: a night hard court seen from above (mt-court.svg, drawn in code) is the one bright
				element. Title and menu sit on the calm green surround to its left. Barlow for the interface,
				Barlow Condensed for the title. One accent, the optic yellow of the ball, marks the selected row.
			*/
			body
			{
				width: 100%;
				height: 100%;
			}
			@keyframes mt-fade-in
			{
				0% { opacity: 0; }
				100% { opacity: 1; }
			}
			@keyframes mt-rise-in
			{
				0% { opacity: 0; transform: translateY(8dp); }
				100% { opacity: 1; transform: translateY(0dp); }
			}
			.launcher
			{
				background-color: #0E1A17;
			}
			.launcher__court
			{
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				animation: 0.6s cubic-out 1 mt-fade-in;
			}
			/* ScreenScraper artwork (fetched at runtime, see ui_screenscraper.cpp). The court and the text
			   title stay as the fallback and are hidden only once the fetched images are in. */
			.launcher__art
			{
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				animation: 0.6s cubic-out 1 mt-fade-in;
			}
			/* Settles the left side so the menu reads over any artwork. */
			/* Near-solid behind the title and menu, then a fade before the middle of the picture.
			   (The renderer draws horizontal-gradient but not linear-gradient, hence two layers.) */
			.launcher__scrim
			{
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				width: 38%;
				background-color: #0B0F0EEB;
			}
			.launcher__scrim-fade
			{
				position: absolute;
				top: 0;
				bottom: 0;
				left: 38%;
				width: 26%;
				decorator: horizontal-gradient(#0B0F0EEB #0B0F0E00);
			}
			.launcher__logo-box
			{
				display: block;
				margin-top: 12dp;
			}
			.launcher__logo
			{
				height: 160dp;
				width: auto;
			}
			.launcher__main
			{
				position: absolute;
				top: 0;
				bottom: 0;
				left: 96dp;
				width: 640dp;
				display: flex;
				flex-direction: column;
				justify-content: center;
				animation: 0.5s 0.2s cubic-out 1 mt-rise-in;
			}
			.launcher__kicker
			{
				font-family: "Barlow";
				font-weight: normal;
				font-size: 22dp;
				font-weight: 500;
				color: #EAEDE3C2;
			}
			.launcher__title
			{
				margin-top: 4dp;
				font-family: "Barlow Condensed";
				font-weight: 600;
				font-size: 104dp;
				white-space: nowrap;
				line-height: 100dp;
				color: #F3F4EE;
			}
			.launcher__menu
			{
				display: flex;
				flex-direction: column;
				width: 320dp;
				margin: 48dp 0 0 -20dp;
			}
			.launcher__menu-divider
			{
				height: 1dp;
				margin: 8dp 20dp;
				background-color: #EAEDE31A;
			}
			.launcher .menu-list-item
			{
				flex-direction: row;
				align-items: center;
				width: 320dp;
				height: 52dp;
				padding: 0 20dp;
				border-radius: 8dp;
				color: #EAEDE3DE;
				background-color: #FFFFFF00;
				decorator: none;
				transition: background-color color 0.12s cubic-out;
			}
			.launcher .menu-list-item__label
			{
				font-family: "Barlow";
				font-weight: 500;
				font-size: 28dp;
				font-effect: shadow(0dp 1dp #00000099);
				letter-spacing: 0dp;
				text-transform: none;
			}
			/* Signature: a ball-yellow dot marks the selected row. */
			.launcher .menu-list-item .menu-list-item__bullet
			{
				width: 10dp;
				height: 10dp;
				margin: 0 14dp 0 0;
				border-radius: 5dp;
				background-color: #D7EE3A;
				opacity: 0;
				transition: opacity 0.12s cubic-out;
			}
			.launcher .menu-list-item:focus:not(:disabled, [disabled]),
			.launcher .menu-list-item:hover:not(:disabled, [disabled])
			{
				color: #F3F4EE;
				background-color: #EAEDE314;
				decorator: none;
			}
			.launcher .menu-list-item:focus:not(:disabled, [disabled]) .menu-list-item__bullet,
			.launcher .menu-list-item:hover:not(:disabled, [disabled]) .menu-list-item__bullet
			{
				opacity: 1;
			}
			/* Online Play panel: replaces the menu in the same column. */
			.online
			{
				display: flex;
				flex-direction: column;
				width: 520dp;
				margin-top: 40dp;
				font-family: "Barlow";
				color: #EAEDE3DE;
			}
			.online__heading
			{
				font-family: "Barlow Condensed";
				font-weight: 600;
				font-size: 40dp;
				color: #F3F4EE;
				margin-bottom: 16dp;
			}
			.online__row
			{
				display: flex;
				flex-direction: row;
				align-items: center;
				margin-bottom: 14dp;
			}
			.online__label
			{
				width: 150dp;
				font-size: 22dp;
				color: #EAEDE3C2;
			}
			.online__segment
			{
				display: flex;
				flex-direction: row;
			}
			.online__chip
			{
				height: 44dp;
				padding: 0 18dp;
				margin-right: 8dp;
				border-radius: 8dp;
				font-size: 22dp;
				line-height: 44dp;
				color: #EAEDE3DE;
				background-color: #EAEDE30F;
				transition: background-color color 0.12s cubic-out;
			}
			.online__chip:hover, .online__chip:focus
			{
				color: #F3F4EE;
				background-color: #EAEDE326;
			}
			.online__chip--on, .online__chip--on:hover, .online__chip--on:focus
			{
				color: #0E1A17;
				background-color: #D7EE3A;
			}
			.online__field
			{
				width: 340dp;
				height: 44dp;
				padding: 0 12dp;
				border-radius: 8dp;
				font-size: 22dp;
				line-height: 44dp;
				color: #F3F4EE;
				background-color: #00000066;
				border-width: 1dp;
				border-color: #EAEDE333;
			}
			.online__field:focus
			{
				border-color: #D7EE3A;
			}
			.online__field--short
			{
				width: 120dp;
			}
			.online__value
			{
				min-width: 60dp;
				font-size: 22dp;
				text-align: center;
				color: #F3F4EE;
			}
			.online__hint
			{
				margin-left: 12dp;
				font-size: 18dp;
				color: #EAEDE3A3;
			}
			.online__note
			{
				font-size: 18dp;
				line-height: 26dp;
				color: #EAEDE3B8;
				margin: 4dp 0 16dp 0;
			}
			.online__status
			{
				font-size: 20dp;
				line-height: 28dp;
				color: #EAEDE3CC;
				margin-bottom: 12dp;
			}
			.online__status--error
			{
				color: #FF9B8A;
			}
			.online .launcher__menu
			{
				margin-top: 8dp;
			}
			.launcher .bottom-left
			{
				bottom: 32dp;
				margin: 0 96dp;
			}
			.launcher .bottom-left label
			{
				font-family: "Barlow";
				font-size: 16dp;
				color: #EAEDE3A3;
			}
		</style>
	</head>
	<body>
		<div id="window" data-model="launcher_model">
			<div class="launcher">
				<svg src="mt-court.svg" class="launcher__court" data-if="!ss_has_background" />
				<div class="launcher__art" data-if="ss_has_background" data-style-decorator="ss_background_decorator"></div>
				<div class="launcher__scrim" data-if="ss_has_background"></div>
				<div class="launcher__scrim-fade" data-if="ss_has_background"></div>
				<div class="launcher__main">
					<div class="launcher__kicker">N64: Recompiled</div>
					<div class="launcher__title" data-if="!ss_has_logo">Mario Tennis</div>
					<div class="launcher__logo-box" data-if="ss_has_logo"><img class="launcher__logo" data-attr-src="ss_logo_src" /></div>
					<div class="launcher__menu" data-if="!net_open">
						<button data-if="!mm_rom_valid" onclick="select_rom" class="menu-list-item" autofocus>
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Select ROM</div>
						</button>
						<button data-if="mm_rom_valid" onclick="start_game" class="menu-list-item" autofocus>
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<button data-if="mm_rom_valid" onclick="open_online" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Online play</div>
						</button>
						<button onclick="open_controls" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Controls</div>
						</button>
						<button onclick="open_settings" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Settings</div>
						</button>
						<div class="launcher__menu-divider"></div>
						<button onclick="exit_game" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Exit</div>
						</button>
					</div>
					<div class="online" data-if="net_open">
						<div class="online__heading">Online play</div>
						<div class="online__row">
							<div class="online__label">Role</div>
							<div class="online__segment">
								<button class="online__chip" data-class-online__chip--on="net_host" onclick="net_set_host" autofocus>Host (player 1)</button>
								<button class="online__chip" data-class-online__chip--on="!net_host" onclick="net_set_join">Join (player 2)</button>
							</div>
						</div>
						<div class="online__row" data-if="!net_host">
							<div class="online__label">Host address</div>
							<input type="text" class="online__field" data-value="net_address" maxlength="255" />
						</div>
						<div class="online__row">
							<div class="online__label">UDP port</div>
							<input type="text" class="online__field online__field--short" data-value="net_port" maxlength="5" />
						</div>
						<div class="online__row" data-if="net_host">
							<div class="online__label">Input delay</div>
							<button class="online__chip" onclick="net_delay_down">-</button>
							<div class="online__value">{{net_delay}}</div>
							<button class="online__chip" onclick="net_delay_up">+</button>
							<div class="online__hint">frames (30 per second)</div>
						</div>
						<div class="online__row">
							<div class="online__label">Your controls</div>
							<button class="online__chip" onclick="net_pad_next">{{net_pad_label}}</button>
						</div>
						<div class="online__note" data-if="net_host">The other player needs this UDP port to reach you: forward it on your router for internet play. They play on a copy of your save and your cheat settings.</div>
						<div class="online__note" data-if="!net_host">You play on a copy of the host's save; your own save isn't changed.</div>
						<div class="online__status" data-class-online__status--error="net_failed" data-if="net_status != ''">{{net_status}}</div>
						<div class="launcher__menu">
							<button class="menu-list-item" onclick="net_start" data-if="!net_busy">
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label" data-if="net_host">Start hosting</div>
								<div class="menu-list-item__label" data-if="!net_host">Connect</div>
							</button>
							<button class="menu-list-item" onclick="net_cancel" data-if="net_busy">
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Cancel</div>
							</button>
							<button class="menu-list-item" onclick="close_online">
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Back</div>
							</button>
						</div>
					</div>
				</div>
				<div class="bottom-left">
					<label>v{{version_number}}</label>
				</div>
			</div>
		</div>
	</body>
</rml>
