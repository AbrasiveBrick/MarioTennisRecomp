<rml>
	<head>
		<title>Launcher</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			/*
				Launcher, unslopped (https://github.com/heydamir/unslop, CC BY 4.0, by Damir Sokolovsky).
				Direction: the splash art is the one bright element; the menu is a quiet dusk scoreboard
				over it. Ink panel, chalk hairline, three text roles, one accent: the optic yellow of a
				tennis ball, used only for the dot that marks the selected row.
			*/
			body
			{
				width: 100%;
				height: 100%;
			}
			@keyframes mt-splash-in
			{
				0% { opacity: 0; }
				100% { opacity: 1; }
			}
			@keyframes mt-menu-in
			{
				0% { opacity: 0; transform: translateY(8dp); }
				100% { opacity: 1; transform: translateY(0dp); }
			}
			.launcher__mt-background
			{
				position: absolute;
				top: 0;
				right: 0;
				bottom: 0;
				left: 0;
				overflow: hidden;
				background-color: #0E1014;
				animation: 0.6s cubic-out 1 mt-splash-in;
			}
			/* Artwork fills the window width, centred vertically; top and bottom are cropped on wide windows. */
			.launcher__mt-splash
			{
				position: absolute;
				left: 0;
				top: 50%;
				width: 100%;
				height: auto;
				transform: translateY(-50%);
			}

			.launcher__vertical-split--right .launcher__content-quadrant
			{
				align-items: flex-end;
				padding: 0 48dp 48dp 0;
			}
			.launcher__menu
			{
				display: flex;
				flex-direction: column;
				width: 336dp;
				padding: 8dp;
				border-width: 1dp;
				border-color: #F4F2EC1A;
				border-radius: 16dp;
				background-color: #101318E0;
				animation: 0.4s 0.3s cubic-out 1 mt-menu-in;
			}
			.launcher__menu-divider
			{
				height: 1dp;
				margin: 4dp 12dp;
				background-color: #F4F2EC1A;
			}
			.launcher .menu-list-item
			{
				flex-direction: row;
				align-items: center;
				height: 56dp;
				padding: 0 20dp;
				border-radius: 8dp;
				color: #F4F2ECB8;
				background-color: #FFFFFF00;
				decorator: none;
				transition: background-color color 0.12s cubic-out;
			}
			.launcher .menu-list-item__label
			{
				font-family: chiaro;
				font-weight: normal;
				font-size: 28dp;
				letter-spacing: 0dp;
				text-transform: none;
			}
			/* Signature: a tennis-ball dot marks the selected row. */
			.launcher .menu-list-item .menu-list-item__bullet
			{
				width: 10dp;
				height: 10dp;
				margin: 0 14dp 0 0;
				border-radius: 5dp;
				background-color: #D7EE3A;
				opacity: 0;
				transition: opacity 0.12s cubic-out;
			}
			.launcher .menu-list-item:focus:not(:disabled, [disabled]),
			.launcher .menu-list-item:hover:not(:disabled, [disabled])
			{
				color: #F4F2EC;
				background-color: #F4F2EC14;
				decorator: none;
			}
			.launcher .menu-list-item:focus:not(:disabled, [disabled]) .menu-list-item__bullet,
			.launcher .menu-list-item:hover:not(:disabled, [disabled]) .menu-list-item__bullet
			{
				opacity: 1;
			}
			.launcher .bottom-left
			{
				bottom: 24dp;
				margin: 0 24dp;
			}
			.launcher .bottom-left label
			{
				font-family: chiaro;
				font-size: 16dp;
				color: #F4F2ECB8;
				font-effect: shadow(0dp 1dp #000000B0);
			}
		</style>
	</head>
	<body>
		<div id="window" data-model="launcher_model">
			<div class="launcher">
				<div class="launcher__mt-background">
					<img src="?/mt-splash" class="launcher__mt-splash" />
				</div>
				<div class="launcher__vertical-split">
					<div class="launcher__title-quadrant"></div>
					<div class="launcher__content-quadrant"></div>
				</div>
				<div class="launcher__vertical-split launcher__vertical-split--right">
					<div class="launcher__title-quadrant launcher__title-quadrant--right"></div>
					<div class="launcher__content-quadrant">
						<div class="launcher__menu">
							<button data-if="!mm_rom_valid" onclick="select_rom" class="menu-list-item" autofocus>
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Select ROM</div>
							</button>
							<button data-if="mm_rom_valid" onclick="start_game" class="menu-list-item" autofocus>
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Start game</div>
							</button>
							<button onclick="open_controls" class="menu-list-item">
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Controls</div>
							</button>
							<button onclick="open_settings" class="menu-list-item">
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Settings</div>
							</button>
							<div class="launcher__menu-divider"></div>
							<button onclick="exit_game" class="menu-list-item">
								<div class="menu-list-item__bullet"></div>
								<div class="menu-list-item__label">Exit</div>
							</button>
						</div>
					</div>
				</div>
				<div class="bottom-left">
					<label>v{{version_number}}</label>
				</div>
			</div>
		</div>
	</body>
</rml>
