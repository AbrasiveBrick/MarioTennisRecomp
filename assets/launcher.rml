<rml>
	<head>
		<title>Launcher</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="recomp.rcss"/>
		<style>
			/*
				Launcher, redesigned with unslop (https://github.com/heydamir/unslop, CC BY 4.0, by Damir Sokolovsky).
				Direction: a night hard court seen from above (mt-court.svg, drawn in code) is the one bright
				element. Title and menu sit on the calm green surround to its left. Barlow for the interface,
				Barlow Condensed for the title. One accent, the optic yellow of the ball, marks the selected row.
			*/
			body
			{
				width: 100%;
				height: 100%;
			}
			@keyframes mt-fade-in
			{
				0% { opacity: 0; }
				100% { opacity: 1; }
			}
			@keyframes mt-rise-in
			{
				0% { opacity: 0; transform: translateY(8dp); }
				100% { opacity: 1; transform: translateY(0dp); }
			}
			.launcher
			{
				background-color: #0E1A17;
			}
			.launcher__court
			{
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				animation: 0.6s cubic-out 1 mt-fade-in;
			}
			.launcher__main
			{
				position: absolute;
				top: 0;
				bottom: 0;
				left: 96dp;
				width: 640dp;
				display: flex;
				flex-direction: column;
				justify-content: center;
				animation: 0.5s 0.2s cubic-out 1 mt-rise-in;
			}
			.launcher__kicker
			{
				font-family: "Barlow";
				font-weight: normal;
				font-size: 20dp;
				color: #EAEDE399;
			}
			.launcher__title
			{
				margin-top: 4dp;
				font-family: "Barlow Condensed";
				font-weight: 600;
				font-size: 104dp;
				white-space: nowrap;
				line-height: 100dp;
				color: #F3F4EE;
			}
			.launcher__menu
			{
				display: flex;
				flex-direction: column;
				width: 320dp;
				margin: 48dp 0 0 -20dp;
			}
			.launcher__menu-divider
			{
				height: 1dp;
				margin: 8dp 20dp;
				background-color: #EAEDE31A;
			}
			.launcher .menu-list-item
			{
				flex-direction: row;
				align-items: center;
				width: 320dp;
				height: 52dp;
				padding: 0 20dp;
				border-radius: 8dp;
				color: #EAEDE3B3;
				background-color: #FFFFFF00;
				decorator: none;
				transition: background-color color 0.12s cubic-out;
			}
			.launcher .menu-list-item__label
			{
				font-family: "Barlow";
				font-weight: normal;
				font-size: 26dp;
				letter-spacing: 0dp;
				text-transform: none;
			}
			/* Signature: a ball-yellow dot marks the selected row. */
			.launcher .menu-list-item .menu-list-item__bullet
			{
				width: 10dp;
				height: 10dp;
				margin: 0 14dp 0 0;
				border-radius: 5dp;
				background-color: #D7EE3A;
				opacity: 0;
				transition: opacity 0.12s cubic-out;
			}
			.launcher .menu-list-item:focus:not(:disabled, [disabled]),
			.launcher .menu-list-item:hover:not(:disabled, [disabled])
			{
				color: #F3F4EE;
				background-color: #EAEDE314;
				decorator: none;
			}
			.launcher .menu-list-item:focus:not(:disabled, [disabled]) .menu-list-item__bullet,
			.launcher .menu-list-item:hover:not(:disabled, [disabled]) .menu-list-item__bullet
			{
				opacity: 1;
			}
			.launcher .bottom-left
			{
				bottom: 32dp;
				margin: 0 96dp;
			}
			.launcher .bottom-left label
			{
				font-family: "Barlow";
				font-size: 16dp;
				color: #EAEDE366;
			}
		</style>
	</head>
	<body>
		<div id="window" data-model="launcher_model">
			<div class="launcher">
				<svg src="mt-court.svg" class="launcher__court" />
				<div class="launcher__main">
					<div class="launcher__kicker">N64: Recompiled</div>
					<div class="launcher__title">Mario Tennis</div>
					<div class="launcher__menu">
						<button data-if="!mm_rom_valid" onclick="select_rom" class="menu-list-item" autofocus>
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Select ROM</div>
						</button>
						<button data-if="mm_rom_valid" onclick="start_game" class="menu-list-item" autofocus>
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Start game</div>
						</button>
						<button onclick="open_controls" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Controls</div>
						</button>
						<button onclick="open_settings" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Settings</div>
						</button>
						<div class="launcher__menu-divider"></div>
						<button onclick="exit_game" class="menu-list-item">
							<div class="menu-list-item__bullet"></div>
							<div class="menu-list-item__label">Exit</div>
						</button>
					</div>
				</div>
				<div class="bottom-left">
					<label>v{{version_number}}</label>
				</div>
			</div>
		</div>
	</body>
</rml>
